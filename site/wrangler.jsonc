// Cloudflare Workers static assets: how the documentation site is served (register.accquix.com).
// Built with `npx blume build` into dist/; deployed with `npx wrangler deploy` by Workers Builds.
{
  "name": "accquix-register-docs",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    // Blume writes each page as <route>/index.html and links to it without a trailing slash; the
    // default would answer /quickstart with a redirect to /quickstart/ (Blume docs, Deployment).
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
