---
// One measured figure: a short value and what it means.
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---
<div class="flex flex-col gap-1 bg-background p-5 text-left">
  <dt class="order-2 m-0 text-muted-foreground text-sm">{label}</dt>
  <dd class="order-1 m-0 whitespace-nowrap font-display font-semibold text-2xl text-foreground tabular-nums md:text-3xl">{value}</dd>
</div>
