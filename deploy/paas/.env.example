# Copy into the platform's environment settings (or to .env for a local test).
# Generate each password with: openssl rand -hex 32
POSTGRES_PASSWORD=
REGISTER_MIGRATE_PASSWORD=
REGISTER_SYNC_PASSWORD=
REGISTER_OPERATOR_PASSWORD=
REGISTER_API_PASSWORD=
# name:sha256hex of each API key. Make a key and its hash with:
#   key=$(openssl rand -hex 24); echo "key: $key"; printf 'default:%s\n' "$(printf %s "$key" | shasum -a 256 | cut -d' ' -f1)"
REGISTER_API_KEYS=
# First deployment only, then remove: REGISTER_SETUP_COMMAND=suppress --init-empty
REGISTER_SETUP_COMMAND=
# Optional
# REGISTER_IMAGE=ghcr.io/accquix/register:<version>
# REGISTER_SYNC_EVERY=1h
# REGISTER_SEARCH_FUZZY=true
# REGISTER_MCP=false
# REGISTER_LOG_LEVEL=info
