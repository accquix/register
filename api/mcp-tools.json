          },
          "mode": {
            "type": "string"
          },
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "address": {
                  "additionalProperties": false,
                  "properties": {
                    "buildingNumber": {
                      "type": "string"
                    },
                    "country": {
                      "type": "string"
                    },
                    "municipality": {
                      "type": "string"
                    },
                    "postalCode": {
                      "type": "string"
                    },
                    "street": {
