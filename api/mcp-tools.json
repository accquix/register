                },
                "matchedName": {
                  "type": "string"
                },
                "municipality": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "typos": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "kind",
                "active"
              ],
              "type": "object"
            },
            "type": [
              "null",
