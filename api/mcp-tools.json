    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search Slovak companies and sole traders by name, IČO, DIČ or IČ DPH. Diacritics, case, word order and the legal form are ignored; the start of any word matches. Returns up to 20 candidates ordered by relevance. A name match is not a confirmation: resolve a candidate with lookup_subject before stating facts about it. Use mode fuzzy only when the default search found nothing. Taxpayers without an IČO (kind taxpayer) appear only when the instance allows it and only for their exact full name; the field taxpayers says whether they were searched, and an empty result is never proof that a person does not exist.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "1 to 20 results, 10 by default",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "description": "default (the normal search) or fuzzy (corrects typos; use only when default found nothing; rate-limited)",
            "enum": [
              "default",
              "fuzzy"
            ],
            "type": "string"
          },
          "q": {
            "description": "a name, IČO (8 digits), DIČ (10 digits) or IČ DPH (SK + 10 digits)",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "type": "object"
      },
      "name": "search_subjects",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
